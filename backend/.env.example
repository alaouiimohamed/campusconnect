# Copier ce fichier en backend/.env puis renseigner les valeurs.
# Ne jamais committer backend/.env.

# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Option A – Neon : coller l'URL de connexion fournie par la console Neon
#   postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# Option B – Docker (docker compose up -d) :
#   postgres://campusconnect:campusconnect@localhost:5432/campusconnect
DATABASE_URL=

# Durée de vie des connexions (secondes). 0 = une connexion par requête.
DB_CONN_MAX_AGE=60

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Limite d'inscriptions par adresse IP (POST /api/auth/register/). Défaut : 10/hour.
# REGISTER_THROTTLE_RATE=10/hour
